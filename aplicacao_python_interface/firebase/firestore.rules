rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function authorized(uid) {
      return request.auth != null && request.auth.uid == uid
        && get(/databases/$(database)/documents/operators/$(uid)).data.enabled == true;
    }
    function stats(d) {
      return d.presentations_count is int && d.evaluated_count is int
        && d.correct_count is int && d.error_count is int
        && d.presentations_count >= d.evaluated_count && d.evaluated_count >= 0
        && d.correct_count >= 0 && d.error_count >= 0
        && d.correct_count + d.error_count == d.evaluated_count
        && (d.accuracy_percent == null ||
            ((d.accuracy_percent is float || d.accuracy_percent is int)
              && d.accuracy_percent >= 0 && d.accuracy_percent <= 100));
    }
    function validPlayer(d, id) {
      return d.keys().hasAll(['schema_version', 'installation_id', 'received_at', 'player_id', 'label',
          'presentations_count', 'evaluated_count', 'correct_count', 'error_count', 'accuracy_percent'])
        && d.keys().hasOnly(['schema_version', 'installation_id', 'received_at', 'player_id', 'label',
          'presentations_count', 'evaluated_count', 'correct_count', 'error_count', 'accuracy_percent'])
        && d.player_id == id && d.label is string && d.label.matches('Jogador [0-9a-f]{8}') && stats(d);
    }
    function validSession(d, id) {
      return d.keys().hasAll(['schema_version', 'installation_id', 'received_at', 'session_id', 'player_id',
          'started_at', 'presentations_count', 'evaluated_count', 'correct_count', 'error_count', 'accuracy_percent', 'by_story'])
        && d.keys().hasOnly(['schema_version', 'installation_id', 'received_at', 'session_id', 'player_id',
          'started_at', 'presentations_count', 'evaluated_count', 'correct_count', 'error_count', 'accuracy_percent', 'by_story'])
        && d.session_id == id && d.player_id is string && d.started_at is timestamp && stats(d)
        && d.by_story is map && d.by_story.keys().hasAll(['0','1','2','3'])
        && d.by_story.keys().hasOnly(['0','1','2','3'])
        && stats(d.by_story['0']) && stats(d.by_story['1']) && stats(d.by_story['2']) && stats(d.by_story['3']);
    }
    function validMove(d, id) {
      return d.keys().hasAll(['schema_version', 'installation_id', 'received_at', 'move_id', 'session_id', 'player_id',
          'occurred_at', 'story', 'character', 'result', 'result_at'])
        && d.keys().hasOnly(['schema_version', 'installation_id', 'received_at', 'move_id', 'session_id', 'player_id',
          'occurred_at', 'story', 'character', 'result', 'result_at'])
        && d.move_id == id && d.session_id is string && d.player_id is string
        && d.occurred_at is timestamp && d.story is int && d.story >= 0 && d.story <= 3
        && d.character is int && d.character >= 0 && d.character <= 5
        && (d.result == null || (d.result is int && (d.result == 0 || d.result == 1)))
        && ((d.result == null && d.result_at == null) || (d.result != null && d.result_at is timestamp));
    }
    match /operators/{uid} {
      // Documento habilitado manualmente pelo administrador no Firebase Console.
      allow get: if request.auth != null && request.auth.uid == uid && resource.data.enabled == true;
      allow list, create, update, delete: if false;
      // Índice mínimo de instalações, sem nomes ou dados pessoais.
      match /installations/{installation} {
        allow get, list: if authorized(uid);
        allow create, update: if authorized(uid)
          && request.resource.data.keys().hasAll(['installation_id', 'schema_version'])
          && request.resource.data.keys().hasOnly(['installation_id', 'schema_version'])
          && request.resource.data.installation_id == installation
          && request.resource.data.schema_version == 1;
        allow delete: if authorized(uid);
      }
      match /installations/{installation}/{collection}/{id} {
        allow read, delete: if authorized(uid) && collection in ['players', 'sessions', 'moves'];
        allow create, update: if authorized(uid)
          && request.resource.data.schema_version == 1
          && request.resource.data.installation_id == installation
          && request.resource.data.received_at == request.time
          && ((collection == 'players' && validPlayer(request.resource.data, id))
            || (collection == 'sessions' && validSession(request.resource.data, id))
            || (collection == 'moves' && validMove(request.resource.data, id)));
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
